variable "env" {
    value "test" {
        environment = ["development"]
    }

    value "staging" {
        environment = ["staging"]
    }

    value "prod" {
        description = ""
        environment = ["production"]
    }
}

variable "namespace" {
    value "website-#{env}" {}
}

variable "host-prefix" {
    value "www.staging" {
        environment = ["staging"]
    }

    value "www" {
        environment = ["production"]
    }

    value "www.test" {
        description = ""
        environment = ["development"]
    }
}

variable "version" {
    value "#{Octopus.Release.Number}" {}
}

variable "UmamiWebsiteId" {
    value "eae5e9cf-3ed3-4bf6-8740-ac8798db3b88" {
        description = ""
        environment = ["staging"]
    }

    value "1ba10366-dc56-4d08-9fa3-bcb179cf1691" {
        description = ""
        environment = ["production"]
    }

    value "af31ee85-0371-4817-a960-6ef6fba287f8" {
        environment = ["development"]
    }
}